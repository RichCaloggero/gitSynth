// gitSynth shared library: coarse pitch tracker (YIN on a decimated signal).
// Needs cookdsp (memalloc), imported before this file.
//
// Object, in cookDSP's style:
//   gs_tracker_init(fmin fmax)
//   gs_tracker_do(x)          call once per sample with the conditioned input
//   this.hz      latest pitch estimate in Hz (held when no pitch is found)
//   this.aper    aperiodicity of that estimate, 0 (perfect) to 1 (noise)
//   this.fresh   1 on the sample a new estimate was made, else 0
//
// How it works:
// - Low-pass at 3 kHz (4th-order Butterworth, two state-variable stages),
//   then keep every Dth sample, so the analysis runs at about 12 kHz.
// - Every 16 decimated samples (about 1.3 ms), run YIN on the newest samples:
//   for each candidate period tau, the mean squared difference between the
//   signal and itself tau samples later. A real period gives a deep dip.
//   Each tau uses a window of 1.5 x tau (at least 48 samples), ending at the
//   newest sample, so high notes are found sooner than low ones.
// - Cumulative-mean normalisation, then the first dip below the threshold
//   (descending to its bottom), refined by parabolic interpolation.

@init

GS_TRK_RATE = 12000;    // target analysis rate
GS_TRK_HOP = 16;        // decimated samples between estimates
GS_TRK_THRESH = 0.15;   // YIN absolute threshold
GS_TRK_BUF = 2048;      // decimated ring buffer (power of two)
GS_TRK_HCHECK_HZ = 400; // harmonic check only for estimates below this

function gs_trk_lp_init(fc q)
  local(g)
(
  g = tan($pi * fc / srate);
  this.k = 1 / q;
  this.a1 = 1 / (1 + g * (g + this.k));
  this.a2 = g * this.a1;
  this.a3 = g * this.a2;
  this.ic1 = this.ic2 = 0;
);

function gs_trk_lp_do(x)
  local(v1 v2 v3)
(
  v3 = x - this.ic2;
  v1 = this.a1 * this.ic1 + this.a2 * v3;
  v2 = this.ic2 + this.a2 * this.ic1 + this.a3 * v3;
  this.ic1 = 2 * v1 - this.ic1;
  this.ic2 = 2 * v2 - this.ic2;
  v2;
);

function gs_tracker_init(fmin fmax)
(
  this.lp1.gs_trk_lp_init(3000, 0.5412);
  this.lp2.gs_trk_lp_init(3000, 1.3066);
  this.dec = max(1, floor(srate / GS_TRK_RATE + 0.5));
  this.fsd = srate / this.dec;
  this.tmin = max(2, floor(this.fsd / fmax));
  this.tmax = ceil(this.fsd / fmin);
  this.buf = memalloc(GS_TRK_BUF);
  this.d = memalloc(this.tmax + 2);
  this.pos = 0;            // next write position in buf
  this.phase = 0;          // counts full-rate samples for decimation
  this.hop = 0;
  this.hz = 0;
  this.aper = 1;
  this.fresh = 0;
);

// Lowest point of d within +-2 of tau (for checking multiples of a period).
function gs_trk_local_min(d tau tmax)
  local(i best)
(
  best = tau;
  i = max(2, tau - 2);
  loop(5,
    i <= tmax && d[i] < d[best] ? best = i;
    i += 1;
  );
  best;
);

// YIN over the newest samples in the ring buffer.
function gs_tracker_estimate()
  local(buf d mask tau w j e s run newest best bestv found m cand t0 a b c den)
(
  buf = this.buf; d = this.d; mask = GS_TRK_BUF - 1;
  newest = this.pos - 1;
  run = 0;
  d[0] = 1;
  tau = 1;
  while (tau <= this.tmax) (
    w = max(48, floor(1.5 * tau));
    s = 0;
    j = newest - w - tau + 1;
    loop(w,
      e = buf[j & mask] - buf[(j + tau) & mask];
      s += e * e;
      j += 1;
    );
    s /= w;
    run += s;
    d[tau] = run > 0 ? s * tau / run : 1;
    tau += 1;
  );
  // First dip under the threshold, followed down to its bottom; if none,
  // the deepest point overall.
  found = 0;
  best = this.tmin; bestv = 2;
  tau = this.tmin;
  while (tau <= this.tmax) (
    !found ? (
      d[tau] < bestv ? (bestv = d[tau]; best = tau;);
      d[tau] < GS_TRK_THRESH ? found = 1;
    ) : (
      d[tau] < bestv ? (bestv = d[tau]; best = tau;) : tau = this.tmax;
    );
    tau += 1;
  );
  // Harmonic check: low strings have strong 2nd and 3rd harmonics, which
  // make a dip at a half or a third of the true period. If two or three
  // times the chosen period has a clearly deeper dip, that is the period.
  // Only when the chosen dip is a poor fit: a near-perfect fit is kept, or a
  // sympathetically ringing lower string pulls the estimate an octave down.
  // Only below GS_TRK_HCHECK_HZ: strong upper harmonics fool YIN on the low
  // strings, while on high notes (B and high E) the check itself caused
  // octave-down errors.
  m = 2;
  loop(2,
    cand = gs_trk_local_min(d, floor(m * best + 0.5), this.tmax);
    m * best <= this.tmax && bestv > 0.05 && this.fsd / best < GS_TRK_HCHECK_HZ &&
      d[cand] < 0.6 * bestv ? (
      best = cand; bestv = d[cand];
    );
    m += 1;
  );
  // Parabolic interpolation around the chosen dip.
  t0 = best;
  best > this.tmin && best < this.tmax ? (
    a = d[best - 1]; b = d[best]; c = d[best + 1];
    den = a - 2 * b + c;
    den > 0 ? t0 = best + 0.5 * (a - c) / den;
  );
  this.aper = min(1, bestv);
  this.hz = this.fsd / t0;
);

function gs_tracker_do(x)
  local(y)
(
  y = this.lp2.gs_trk_lp_do(this.lp1.gs_trk_lp_do(x));
  this.fresh = 0;
  this.phase += 1;
  this.phase >= this.dec ? (
    this.phase = 0;
    this.buf[this.pos & (GS_TRK_BUF - 1)] = y;
    this.pos += 1;
    this.hop += 1;
    this.hop >= GS_TRK_HOP ? (
      this.hop = 0;
      this.gs_tracker_estimate();
      this.fresh = 1;
    );
  );
);

// ---------------------------------------------------------------------------
// Fine tracker ("PLL"): measures the string's fundamental cycle by cycle.
//   gs_pll_init()
//   gs_pll_do(x seed_hz reseed)   call once per sample
//     seed_hz: starting pitch from the coarse tracker; reseed: 1 to restart
//     from seed_hz (a new note, or the fine tracker lost the note)
//   this.hz      latest pitch in Hz (0 until the first cycle is measured)
//   this.locked  1 once consecutive cycles agree
//   this.alive   1 while cycles are still being measured (within 3 periods)
//
// Two band-pass filters centred on the note isolate its fundamental; the
// centre follows the measured pitch, so bends are followed. A zero crossing
// with hysteresis marks each cycle, timed to a fraction of a sample, so the
// pitch updates every cycle: every 12 ms on low E, every 1 ms high up. The
// pitch is the average over the cycles of about the last 10 ms (2 to 16
// cycles): at least two, which cancels most of the wobble a strong 2nd
// harmonic adds to single cycles, and more on high notes, whose short cycles
// are timed less precisely. A cycle more than 35% away from the filter
// centre is rejected (a harmonic or noise crossing).

GS_PLL_Q = 1.5;          // each of the two band-pass stages
GS_PLL_AGREE = 30;       // cents: consecutive cycles this close count as locked
GS_PLL_AVG_S = 0.01;     // average the cycles of about this long
GS_PLL_MAXC = 16;        // most cycles averaged
GS_PLL_FOLLOW = 0.05;    // share of the gap to the measured pitch the filter moves per cycle

function gs_pll_bp(x fc)
  local(g k a1 a2 a3 v1 v2 v3)
(
  g = tan($pi * fc / srate);
  k = 1 / GS_PLL_Q;
  a1 = 1 / (1 + g * (g + k));
  a2 = g * a1;
  a3 = g * a2;
  v3 = x - this.ic2;
  v1 = a1 * this.ic1 + a2 * v3;
  v2 = this.ic2 + a2 * this.ic1 + a3 * v3;
  this.ic1 = 2 * v1 - this.ic1;
  this.ic2 = 2 * v2 - this.ic2;
  k * v1;
);

function gs_pll_init()
(
  this.s1.ic1 = this.s1.ic2 = this.s2.ic1 = this.s2.ic2 = 0;
  this.fc = 0;
  this.hz = 0;
  this.locked = this.alive = 0;
  this.n = 0;
  this.prev = 0;
  this.env = 0;
  this.env_c = 1 - exp(-1 / (0.01 * srate));
  this.armed = 0;
  this.last_t = -1;
  this.per = memalloc(GS_PLL_MAXC);   // ring of accepted periods, in samples
  this.np = this.wp = 0;               // periods held, next write position
  this.f_prev = 0;
  this.agree = this.bad = 0;
  this.misses = 0;
);

function gs_pll_do(x seed_hz reseed)
  local(b th t p f per want sum i j)
(
  reseed && seed_hz > 0 ? (
    this.fc = seed_hz;
    this.hz = 0;
    this.locked = this.alive = 0;
    this.last_t = -1;
    this.np = 0;
    this.agree = this.bad = 0;
    this.misses = 0;
  );
  this.fc > 0 ? (
    b = this.s2.gs_pll_bp(this.s1.gs_pll_bp(x, this.fc), this.fc);
    this.env += this.env_c * (abs(b) - this.env);
    th = 0.3 * this.env;
    b < -th ? this.armed = 1;
    this.armed && b >= 0 && this.prev < 0 ? (
      this.armed = 0;
      t = this.n - 1 + (-this.prev) / (b - this.prev);   // fractional crossing time
      this.last_t >= 0 ? (
        p = t - this.last_t;
        f = srate / p;
        f > 0.74 * this.fc && f < 1.35 * this.fc ? (
          per = this.per;
          per[this.wp] = p;
          this.wp = (this.wp + 1) % GS_PLL_MAXC;
          this.np = min(GS_PLL_MAXC, this.np + 1);
          want = min(this.np, max(2, min(GS_PLL_MAXC, floor(GS_PLL_AVG_S * f + 0.5))));
          sum = 0; i = 0;
          loop(want,
            j = (this.wp - 1 - i + GS_PLL_MAXC) % GS_PLL_MAXC;
            sum += per[j];
            i += 1;
          );
          this.hz = want * srate / sum;
          this.alive = 1;
          // Re-centre the band-pass slowly: it is wide, and re-centring on every
          // cycle shifts its phase, which fed back into the next measurement
          // as a regular wobble of about 3 cents.
          this.fc += GS_PLL_FOLLOW * (this.hz - this.fc);
          // Lock after two agreeing cycles; unlock only after three
          // disagreeing cycles in a row, so the lock does not flicker.
          this.f_prev > 0 && abs(1200 * log(f / this.f_prev) / log(2)) < GS_PLL_AGREE ? (
            this.agree += 1; this.bad = 0;
          ) : (
            this.agree = 0; this.bad += 1;
          );
          this.f_prev = f;
          this.agree >= 2 ? this.locked = 1;
          this.bad >= 3 ? this.locked = 0;
          this.misses = 0;
        ) : (
          this.misses += 1;
          this.misses > 4 ? this.locked = 0;
        );
      );
      this.last_t = t;
    );
    // No cycle for three periods: the note has gone.
    this.last_t >= 0 && this.n - this.last_t > 3 * srate / this.fc ? this.locked = this.alive = 0;
    this.prev = b;
  );
  this.n += 1;
);
