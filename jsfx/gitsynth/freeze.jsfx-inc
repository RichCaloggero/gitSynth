// gitSynth shared library: dynamic freeze.
// Needs cookdsp (memalloc), imported before this file.
//
// Object, in cookDSP's style:
//   gs_freeze_init()
//   gs_freeze_do(x onset valid enabled grain_ms xfade_ms settle_ms mix)   returns the output
//     onset: 1 while a new attack is detected; valid: 0 abandons a capture
//     (the gate closed, so the "note" was noise); enabled: 0 or 1;
//     grain_ms: grain length; xfade_ms: fade in and out of the frozen sound;
//     settle_ms: wait after an attack before capturing; mix 0-1.
//   this.frozen is 1 while a frozen sound is playing.
//
// After each attack it waits for the note to settle, captures a slice
// (four grains long, at least 300 ms), then plays it back as four overlapping
// grains with smooth (Hann) windows, each starting at a random point in the
// slice, so the loop has no repeating seam. The frozen sound fades in as the
// live sound fades down. A new attack brings the live sound back at once,
// fades the old frozen sound out, and captures the new note into the other
// buffer, so the two can overlap. Fast playing never settles, so stays live.

@init

GS_FREEZE_VOICES = 4;
GS_FREEZE_NORM = 1 / sqrt(3 * GS_FREEZE_VOICES / 8);   // RMS of 4 random Hann grains

function gs_fslot_init(maxlen)
(
  this.buf = memalloc(maxlen);
  this.pos = memalloc(GS_FREEZE_VOICES);
  this.cnt = memalloc(GS_FREEZE_VOICES);
  this.len = this.g = 1;
  this.gain = this.target = 0;
  this.step = 0.001;
);

// Start playing the captured slice: len samples, grains of g samples.
function gs_fslot_start(len g step)
  local(v)
(
  this.len = len; this.g = g; this.step = step;
  v = 0;
  loop(GS_FREEZE_VOICES,
    this.cnt[v] = floor(v * g / GS_FREEZE_VOICES);
    this.pos[v] = floor(rand(1) * (len - g));
    v += 1;
  );
  this.target = 1;
);

function gs_fslot_release(step)
(
  this.target = 0;
  this.step = step;
);

function gs_fslot_do()
  local(s v n buf pos cnt g)
(
  s = 0;
  (this.gain > 0 || this.target > 0) ? (
    buf = this.buf; pos = this.pos; cnt = this.cnt; g = this.g;
    v = 0;
    loop(GS_FREEZE_VOICES,
      n = cnt[v];
      s += buf[pos[v] + n] * (0.5 - 0.5 * cos(2 * $pi * n / g));
      n += 1;
      n >= g ? (
        n = 0;
        pos[v] = floor(rand(1) * (this.len - g));
      );
      cnt[v] = n;
      v += 1;
    );
    this.gain = this.target > this.gain ?
      min(this.target, this.gain + this.step) :
      max(this.target, this.gain - this.step);
    s *= GS_FREEZE_NORM * this.gain;
  );
  s;
);

function gs_freeze_init()
(
  this.maxlen = ceil(2 * srate);
  this.a.gs_fslot_init(this.maxlen);
  this.b.gs_fslot_init(this.maxlen);
  this.state = 0;       // 0 live, 1 settling, 2 capturing, 3 frozen
  this.use_b = 0;       // which buffer the next capture goes into
  this.timer = this.capn = this.caplen = this.grain = 0;
  this.live = 1;
  this.live_up = 1 / (0.02 * srate);     // live sound returns in 20 ms
  this.frozen = 0;
);

function gs_freeze_do(x onset valid enabled grain_ms xfade_ms settle_ms mix)
  local(step out)
(
  step = 1 / max(1, xfade_ms * 0.001 * srate);
  (onset || !enabled) ? (
    this.state == 3 || this.state == 2 ? (
      this.a.gs_fslot_release(step);
      this.b.gs_fslot_release(step);
    );
    this.state = enabled ? 1 : 0;
    this.timer = 0;
  );
  (this.state == 1 || this.state == 2) && !valid ? this.state = 0;

  this.state == 1 ? (
    this.timer += 1;
    this.timer >= settle_ms * 0.001 * srate ? (
      this.grain = max(16, floor(grain_ms * 0.001 * srate));
      this.caplen = min(this.maxlen, max(4 * this.grain, floor(0.3 * srate)));
      this.capn = 0;
      this.state = 2;
    );
  ) : this.state == 2 ? (
    this.use_b ? (this.b.buf[this.capn] = x) : (this.a.buf[this.capn] = x);
    this.capn += 1;
    this.capn >= this.caplen ? (
      this.use_b ?
        this.b.gs_fslot_start(this.caplen, this.grain, step) :
        this.a.gs_fslot_start(this.caplen, this.grain, step);
      this.use_b = !this.use_b;
      this.state = 3;
    );
  );

  // Live sound: fades down as the frozen sound fades in, returns quickly.
  this.state == 3 ?
    this.live = max(1 - mix, this.live - step) :
    this.live = min(1, this.live + this.live_up);
  this.frozen = this.state == 3;

  out = x * this.live + mix * (this.a.gs_fslot_do() + this.b.gs_fslot_do());
  out;
);
