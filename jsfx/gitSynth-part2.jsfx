desc:gitSynth Part 2 - tracked voice (step 13: fine tracker test)
// Mono guitar in on channel 1. A sine at the tracked pitch, following the
// guitar's loudness, goes to channels 1 and 2. For testing, channel 3
// carries the pitch (Hz / 2000, 0 when no pitch) and channel 4 the
// coarse tracker's aperiodicity (0 = clean pitch, 1 = noise), or with the
// fine tracker on, 1 while it is locked.
//
// Tracker "Coarse + fine": the coarse tracker (YIN) seeds the fine tracker
// at each new note; once the fine tracker has locked, its pitch is used for
// as long as it keeps measuring cycles (switching back and forth between the
// two trackers made the pitch wobble). If
// the coarse tracker disagrees with it by more than 1.5 semitones for about
// 50 ms (a legato note change, or the fine tracker lost the note), the fine
// tracker is restarted from the coarse pitch.

slider1:gate_db=-45<-90,-20,0.5>Gate threshold (dB)
slider2:max_aper=0.3<0.05,1,0.01>Pitch confidence limit (aperiodicity)
slider3:out_db=-6<-24,12,0.1>Output level (dB)
slider4:mix=100<0,100,1>Dry/wet (%)
slider5:tracker=0<0,1,1{Coarse only,Coarse + fine (experimental)}>Tracker

import cookdsp/cookdsp.jsfx-inc
import gitsynth/tracker.jsfx-inc

in_pin:Guitar
out_pin:Left
out_pin:Right
out_pin:Debug pitch
out_pin:Debug aperiodicity

@init
__memory_next = 0;   // cookDSP's memalloc starts again on every re-init
FMIN = 70; FMAX = 1400;
GATE_HYST_DB = 6;

// Input high-pass at 70 Hz (as Part 1).
hp_g = tan($pi * 70 / srate); hp_k = sqrt(2);
hp_a1 = 1 / (1 + hp_g * (hp_g + hp_k)); hp_a2 = hp_g * hp_a1; hp_a3 = hp_g * hp_a2;
hp_ic1 = hp_ic2 = 0;

level_att_c = 1 - exp(-1 / (0.001 * srate));
level_rel_c = 1 - exp(-1 / (0.2 * srate));
amp_att_c = 1 - exp(-1 / (0.005 * srate));
amp_rel_c = 1 - exp(-1 / (0.1 * srate));
level = amp = 0;
gate_open = 0;

trk.gs_tracker_init(FMIN, FMAX);
pll.gs_pll_init();
voiced = 0;
// Attack detector (as Part 1): fast envelope rising 6 dB above a 30 ms copy.
fast_att_c = 1 - exp(-1 / (0.001 * srate));
fast_rel_c = 1 - exp(-1 / (0.05 * srate));
onset_c = 1 - exp(-1 / (0.03 * srate));
env_fast = onset_slow = 0;
need_seed = 1;
disagree = 0;
pll_used = 0;
DISAGREE_CENTS = 150;
DISAGREE_N = 40;     // coarse estimates, about 50 ms
pitch = 0;
osc_phase = 0;

@slider
outg = 10 ^ (out_db / 20);
wet = mix / 100;

@sample
x = spl0;
v3 = x - hp_ic2;
v1 = hp_a1 * hp_ic1 + hp_a2 * v3;
v2 = hp_ic2 + hp_a2 * hp_ic1 + hp_a3 * v3;
hp_ic1 = 2 * v1 - hp_ic1;
hp_ic2 = 2 * v2 - hp_ic2;
x = x - hp_k * v1 - v2;

// Gate, as Part 1: peak level with 6 dB hysteresis.
a = abs(x);
level += (a > level ? level_att_c : level_rel_c) * (a - level);
level_db = 20 * log10(level + 0.0000000001);
gate_open ? (
  level_db < gate_db - GATE_HYST_DB ? gate_open = 0;
) : (
  level_db > gate_db ? gate_open = 1;
);

// Attack detector: a new note needs a fresh seed for the fine tracker.
env_fast += (a > env_fast ? fast_att_c : fast_rel_c) * (a - env_fast);
onset_slow += (env_fast > onset_slow ? onset_c : 1) * (env_fast - onset_slow);
((gate_open && env_fast > 2 * onset_slow + 0.0001) || !gate_open) ? need_seed = 1;

// Coarse pitch: accept an estimate only while the gate is open and it is clean.
trk.gs_tracker_do(x);
reseed = 0;
trk.fresh ? (
  coarse_ok = gate_open && trk.aper < max_aper;
  coarse_ok ? (
    need_seed ? (
      reseed = 1; need_seed = 0; disagree = 0;
    ) : pll.hz > 0 && abs(1200 * log(trk.hz / pll.hz) / log(2)) > DISAGREE_CENTS ? (
      disagree += 1;
      disagree >= DISAGREE_N ? (reseed = 1; disagree = 0;);
    ) : disagree = 0;
  );
  !tracker ? (voiced = coarse_ok; voiced ? pitch = trk.hz;);
);
pll.gs_pll_do(x, trk.hz, tracker && reseed);
pll.locked ? pll_used = 1;
!pll.alive ? pll_used = 0;
tracker ? (
  pll_used ? (
    voiced = 1; pitch = pll.hz;
  ) : trk.fresh ? (
    voiced = coarse_ok; voiced ? pitch = trk.hz;
  );
);
!gate_open ? voiced = 0;

// Sine at the tracked pitch, with the guitar's loudness.
amp += (a > amp ? amp_att_c : amp_rel_c) * (a - amp);
pitch > 0 ? (
  osc_phase += pitch / srate;
  osc_phase >= 1 ? osc_phase -= 1;
);
voice = sin(2 * $pi * osc_phase) * amp * gate_open;

y = (x + wet * (voice - x)) * outg;
spl0 = spl1 = y;
spl2 = voiced ? pitch / 2000 : 0;
spl3 = tracker ? pll.locked : trk.aper;
