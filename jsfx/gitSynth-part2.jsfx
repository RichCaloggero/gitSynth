desc:gitSynth Part 2 - tracked voice (Voice A oscillators, Voice B flute)
// Mono guitar in on channel 1. An oscillator at the tracked pitch, following
// the guitar's loudness, goes to channels 1 and 2. For testing, channel 3
// carries the pitch (Hz / 2000, 0 when no pitch) and channel 4 the
// coarse tracker's aperiodicity (0 = clean pitch, 1 = noise), or with the
// fine tracker on, 1 while it is locked.
//
// Tracker "Coarse + fine": the coarse tracker (YIN) seeds the fine tracker
// at each new note; once the fine tracker has locked, its pitch is used for
// as long as it keeps measuring cycles. A confirmed note change restarts it.
//
// Note logic (both modes): at each pick the voice is muted and the pitch is
// found afresh (attack skip, then confirmation). Within a note, nearby
// pitches are followed at once; a distant one must persist for about 16 ms,
// and one more than a fifth away for about 65 ms (or come with a new pick).
// A sudden fall in level (a mute) silences the voice until the next pick.

slider1:gate_db=-45<-90,-20,0.5>Gate threshold (dB)
slider2:max_aper=0.2<0.05,1,0.01>Pitch confidence limit (aperiodicity)
slider3:tracker=0<0,1,1{Coarse only,Coarse + fine (experimental)}>Tracker
slider4:skip_ms=5<0,60,1>Attack skip (ms)

slider6:wave=2<0,5,1{Sine,Triangle,Saw,Square,Pulse,Flute (physical model)}>Voice
slider7:bright=50<0,100,1>Brightness (%)
slider8:pitch_mode=0<0,1,1{Follow playing,Snap to semitones}>Pitch mode
slider9:snap_pct=100<0,100,1>Snap strength (%)
slider10:glide_ms=0<0,1000,1>Glide (ms)
slider11:transpose=0<-24,24,1>Transpose (semitones)

slider13:mix=100<0,100,1>Dry/wet (%)
slider14:out_db=-6<-24,12,0.1>Output level (dB)

slider16:fl_pressure=100<70,130,1>Flute breath pressure (%)
slider17:fl_noise_on=60<0,100,1>Flute breath noise at note start (%)
slider18:fl_noise_hold=5<0,100,1>Flute breath noise while held (%)
slider19:fl_attack_ms=5<1,300,1:log>Flute breath attack (ms)
slider20:fl_noise_ms=80<10,1000,1:log>Flute breath noise fade (ms)
slider21:fl_pink=1<0,1,1{White,Pink}>Flute breath noise colour

import cookdsp/cookdsp.jsfx-inc
import lib/svf.jsfx-inc
import lib/dynamics.jsfx-inc
import lib/tracker.jsfx-inc
import lib/notes.jsfx-inc
import lib/flute.jsfx-inc

in_pin:Guitar
out_pin:Left
out_pin:Right
out_pin:Debug pitch
out_pin:Debug aperiodicity

@init
__memory_next = 0;   // cookDSP's memalloc starts again on every re-init
FMIN = 70; FMAX = 1400;
GATE_HYST_DB = 6;

// Input high-pass at 70 Hz (as Part 1).
hpf.gs_svf_init();
hpf.gs_svf_set(70, sqrt(2));

// Envelope followers, gate and attack detector, from lib/dynamics.jsfx-inc.
level_env.gs_env_init(); level_env.gs_env_set(0.001, 0.2);
amp_env.gs_env_init(); amp_env.gs_env_set(0.005, 0.03);   // the voice dies with the string
ngate.gs_gate_init();                                     // threshold from slider

trk.gs_tracker_init(FMIN, FMAX);
pll.gs_pll_init();
voiced = 0;
// Attack detector (as Part 1): fast envelope rising 6 dB above a 30 ms copy.
fast_env.gs_env_init(); fast_env.gs_env_set(0.001, 0.05);
att.gs_attack_init(); att.gs_attack_set(0.03);
notes.gs_notes_init();   // note logic, from lib/notes.jsfx-inc
pll_used = 0;
voice_gain = 0;
voice_c = 1 - exp(-1 / (0.003 * srate));
pitch = 0;
osc_phase = 0;
osc.blosc(110, 0.5, 0);
fl.gs_flute_init();
fl_pr = 0;
fl_chiff = 0; fl_was_voiced = 0;
fl_rel_c = 1 - exp(-1 / (0.02 * srate));   // breath stops in about 20 ms
FLUTE_GAIN = 1;
voice_m = 0;         // sounding pitch, in MIDI note units (69 = A4)

@slider
ngate.gs_gate_set(gate_db, GATE_HYST_DB, 0.002, 0.15);
outg = 10 ^ (out_db / 20);
wet = mix / 100;
// Waveform: 0 sine (our own), otherwise cookDSP's band-limited oscillator
// (types 3 triangle, 0 saw, 2 square, 4 pulse); brightness is its sharpness.
osc.blosc_set_type(wave == 1 ? 3 : wave == 2 ? 0 : wave == 3 ? 2 : 4);
osc.blosc_set_sharp(bright / 100);
glide_c = glide_ms > 0 ? 1 - exp(-1 / (glide_ms * 0.001 * srate)) : 1;
fl_att_c = 1 - exp(-1 / (fl_attack_ms * 0.001 * srate));
fl_chiff_c = exp(-1 / (fl_noise_ms * 0.001 * srate));
// Noise sliders: 100% is 6% of the breath pressure, on a squared scale so
// the useful low settings get most of the travel (25% is about 0.4%).
fl_n_on = 0.06 * (fl_noise_on / 100) ^ 2;
fl_n_hold = 0.06 * (fl_noise_hold / 100) ^ 2;

@sample
x = spl0;
hpf.gs_svf_tick(x);
x = hpf.hp;

// Gate, as Part 1: peak level with 6 dB hysteresis.
a = abs(x);
level = level_env.gs_env_do(a);
level_db = 20 * log10(level + 0.0000000001);
ngate.gs_gate_do(level_db);
gate_open = ngate.open;

// Note logic, from lib/notes.jsfx-inc: at each pick the voice is muted and
// the pitch found afresh (attack skip, then confirmation); within a note,
// nearby pitches are followed at once and distant ones must persist; a
// sudden fall in level (a mute) silences the voice until the next pick.
env_fast = fast_env.gs_env_do(a);
att.gs_attack_do(env_fast, 2, gate_open);
trk.gs_tracker_do(x);
notes.gs_notes_do(att.start, gate_open, trk.fresh, trk.hz, trk.aper, max_aper,
                  skip_ms * 0.001, env_fast);
voiced = notes.voiced;

// Fine tracker (experimental): restarted at each new note from its pitch;
// once locked, its pitch is used while it keeps measuring cycles.
(att.start || !gate_open || notes.new_note) ? pll_used = 0;
pll.gs_pll_do(x, notes.new_note ? notes.seed_hz : trk.hz, tracker && notes.new_note);
tracker && voiced ? (
  pll.locked ? pll_used = 1;
  !pll.alive ? pll_used = 0;
);
pitch = tracker && pll_used ? pll.hz : notes.hz;

// Pitch shaping: follow the playing exactly, or pull it towards the nearest
// semitone by the snap strength; transpose; then glide between notes. A note
// that starts from silence jumps straight to its pitch (no glide in).
amp = amp_env.gs_env_do(a);
pitch > 0 ? (
  m = 69 + 12 * log(pitch / 440) / log(2);
  pitch_mode ? m += snap_pct / 100 * (floor(m + 0.5) - m);
  m += transpose;
  voice_gain < 0.01 || voice_m <= 0 ? voice_m = m : voice_m += glide_c * (m - voice_m);
  vhz = 440 * 2 ^ ((voice_m - 69) / 12);
  vhz = min(vhz, 0.45 * srate);
  wave == 0 ? (
    osc_phase += vhz / srate;
    osc_phase >= 1 ? osc_phase -= 1;
    o = sin(2 * $pi * osc_phase);
  ) : wave <= 4 ? (
    osc.blosc_set_freq(vhz);
    o = osc.blosc_do();
  );
);
// Flute: the breath pressure ramps up at each note over the breath attack
// and stops quickly when the note ends; the guitar's loudness sets the
// flute's loudness. The tone starts above about 80% pressure.
wave == 5 ? (
  fl_target = voiced ? fl_pressure / 100 : 0;
  // The breath noise starts strong at each note and fades as the tube's
  // resonance takes over, down to the held amount.
  voiced && !fl_was_voiced ? fl_chiff = 1;
  fl_was_voiced = voiced;
  fl_chiff *= fl_chiff_c;
  fl_pr += (fl_target > fl_pr ? fl_att_c : fl_rel_c) * (fl_target - fl_pr);
  o = FLUTE_GAIN * fl.gs_flute_do(vhz > 0 ? vhz : 220, fl_pr,
                                  fl_n_hold + (fl_n_on - fl_n_hold) * fl_chiff, fl_pink);
);
voice_gain += voice_c * (voiced - voice_gain);    // 3 ms fade in and out
voice = o * amp * gate_open * voice_gain;

y = (x + wet * (voice - x)) * outg;
spl0 = spl1 = y;
spl2 = voiced ? pitch / 2000 : 0;
spl3 = tracker ? pll.locked : trk.aper;
