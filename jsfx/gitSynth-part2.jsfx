desc:gitSynth Part 2 - tracked voice (step 13: fine tracker test)
// Mono guitar in on channel 1. A sine at the tracked pitch, following the
// guitar's loudness, goes to channels 1 and 2. For testing, channel 3
// carries the pitch (Hz / 2000, 0 when no pitch) and channel 4 the
// coarse tracker's aperiodicity (0 = clean pitch, 1 = noise), or with the
// fine tracker on, 1 while it is locked.
//
// Tracker "Coarse + fine": the coarse tracker (YIN) seeds the fine tracker
// at each new note; once the fine tracker has locked, its pitch is used for
// as long as it keeps measuring cycles. A confirmed note change restarts it.
//
// Note logic (both modes): at each pick the voice is muted and the pitch is
// found afresh (attack skip, then confirmation). Within a note, nearby
// pitches are followed at once; a distant one must persist for about 16 ms,
// and one more than a fifth away for about 65 ms (or come with a new pick).
// A sudden fall in level (a mute) silences the voice until the next pick.

slider1:gate_db=-45<-90,-20,0.5>Gate threshold (dB)
slider2:max_aper=0.3<0.05,1,0.01>Pitch confidence limit (aperiodicity)
slider3:out_db=-6<-24,12,0.1>Output level (dB)
slider4:mix=100<0,100,1>Dry/wet (%)
slider5:tracker=0<0,1,1{Coarse only,Coarse + fine (experimental)}>Tracker
slider6:skip_ms=5<0,60,1>Attack skip (ms)

import cookdsp/cookdsp.jsfx-inc
import gitsynth/tracker.jsfx-inc

in_pin:Guitar
out_pin:Left
out_pin:Right
out_pin:Debug pitch
out_pin:Debug aperiodicity

@init
__memory_next = 0;   // cookDSP's memalloc starts again on every re-init
FMIN = 70; FMAX = 1400;
GATE_HYST_DB = 6;

// Input high-pass at 70 Hz (as Part 1).
hp_g = tan($pi * 70 / srate); hp_k = sqrt(2);
hp_a1 = 1 / (1 + hp_g * (hp_g + hp_k)); hp_a2 = hp_g * hp_a1; hp_a3 = hp_g * hp_a2;
hp_ic1 = hp_ic2 = 0;

level_att_c = 1 - exp(-1 / (0.001 * srate));
level_rel_c = 1 - exp(-1 / (0.2 * srate));
amp_att_c = 1 - exp(-1 / (0.005 * srate));
amp_rel_c = 1 - exp(-1 / (0.03 * srate));   // the voice dies with the string
level = amp = 0;
gate_open = 0;

trk.gs_tracker_init(FMIN, FMAX);
pll.gs_pll_init();
voiced = 0;
// Attack detector (as Part 1): fast envelope rising 6 dB above a 30 ms copy.
fast_att_c = 1 - exp(-1 / (0.001 * srate));
fast_rel_c = 1 - exp(-1 / (0.05 * srate));
onset_c = 1 - exp(-1 / (0.03 * srate));
env_fast = onset_slow = 0;
need_seed = 1;
pll_used = 0;
CONFIRM = 4;         // coarse estimates a new pitch must repeat for (about 5 ms)
HOLD_CENTS = 70;     // within a note, closer estimates are followed at once
CHANGE_N = 12;       // a pitch further away must repeat this often (about 16 ms)
BIG_JUMP_CENTS = 700; // a slide or hammer-on rarely jumps more than a fifth;
BIG_JUMP_N = 48;     // a bigger jump (octave errors, a ringing low string) needs ~65 ms
MUTE_DROP_DB = 12;   // a fall this large within MUTE_MS is a mute, not a decay
MUTE_MS = 40;
MUTE_IGNORE_MS = 60; // the pick's own spike falls quickly; not a mute
chg_n = 0; chg_hz = 0; muted = 0;
lvl_ring = memalloc(128); lvl_pos = 0; lvl_tick = 0;
ms_samples = floor(srate / 1000);
since_attack = 0; confirm_n = 0; cand_hz = 0; prev_attack = 0;
voice_gain = 0;
voice_c = 1 - exp(-1 / (0.003 * srate));
pitch = 0;
osc_phase = 0;

@slider
outg = 10 ^ (out_db / 20);
wet = mix / 100;

@sample
x = spl0;
v3 = x - hp_ic2;
v1 = hp_a1 * hp_ic1 + hp_a2 * v3;
v2 = hp_ic2 + hp_a2 * hp_ic1 + hp_a3 * v3;
hp_ic1 = 2 * v1 - hp_ic1;
hp_ic2 = 2 * v2 - hp_ic2;
x = x - hp_k * v1 - v2;

// Gate, as Part 1: peak level with 6 dB hysteresis.
a = abs(x);
level += (a > level ? level_att_c : level_rel_c) * (a - level);
level_db = 20 * log10(level + 0.0000000001);
gate_open ? (
  level_db < gate_db - GATE_HYST_DB ? gate_open = 0;
) : (
  level_db > gate_db ? gate_open = 1;
);

// Attack detector. At each new attack the voice is muted and the pitch is
// found afresh: estimates from the first skip_ms (pick noise) are ignored,
// then a pitch must repeat within 50 cents for CONFIRM estimates (about
// 5 ms) before it is used. That pitch seeds the fine tracker and unmutes the
// voice; from then on the voice holds the last good pitch until the next
// attack or the gate closes.
env_fast += (a > env_fast ? fast_att_c : fast_rel_c) * (a - env_fast);
onset_slow += (env_fast > onset_slow ? onset_c : 1) * (env_fast - onset_slow);
attack = gate_open && env_fast > 2 * onset_slow + 0.0001;
// Restart only where an attack begins (it stays detected through the rise
// of the pick, which would otherwise keep restarting the skip).
((attack && !prev_attack) || !gate_open) ? (
  need_seed = 1; since_attack = 0; confirm_n = 0; pll_used = 0; voiced = 0;
  muted = 0;
) : since_attack += 1;
prev_attack = attack;

// Coarse pitch.
trk.gs_tracker_do(x);
reseed = 0;
trk.fresh ? (
  coarse_ok = gate_open && trk.aper < max_aper && since_attack >= skip_ms * 0.001 * srate;
  coarse_ok ? (
    need_seed && !muted ? (
      confirm_n > 0 && abs(1200 * log(trk.hz / cand_hz) / log(2)) < 50 ? (
        confirm_n += 1;
        cand_hz += 0.3 * (trk.hz - cand_hz);
      ) : (
        cand_hz = trk.hz;
        confirm_n = 1;
      );
      confirm_n >= CONFIRM ? (
        reseed = 1; need_seed = 0;
        pitch = cand_hz; voiced = 1;
      );
    ) : need_seed ? 0 : (
      // Note established. Estimates close to the note are followed at once
      // (bends, vibrato); one further away must repeat for CHANGE_N estimates
      // before the note changes (a hammer-on or slide), so brief junk from
      // mutes, touched strings and pick noise is ignored.
      abs(1200 * log(trk.hz / pitch) / log(2)) <= HOLD_CENTS ? (
        !tracker || !pll_used ? pitch = trk.hz;
        chg_n = 0;
      ) : (
        chg_n > 0 && abs(1200 * log(trk.hz / chg_hz) / log(2)) < 50 ? (
          chg_n += 1; chg_hz += 0.3 * (trk.hz - chg_hz);
        ) : (
          chg_hz = trk.hz; chg_n = 1;
        );
        chg_n >= (abs(1200 * log(chg_hz / pitch) / log(2)) > BIG_JUMP_CENTS ? BIG_JUMP_N : CHANGE_N) ? (
          pitch = chg_hz; cand_hz = chg_hz; reseed = 1; pll_used = 0; chg_n = 0;
        );
      );
    );
  );
);
pll.gs_pll_do(x, reseed ? cand_hz : trk.hz, tracker && reseed);
tracker && voiced ? (
  pll.locked ? pll_used = 1;
  !pll.alive ? pll_used = 0;
  pll_used ? pitch = pll.hz;
);

// Mute detection: a fall of MUTE_DROP_DB within MUTE_MS (much faster than a
// string decays) silences the voice at once; a new pick starts it again.
lvl_tick += 1;
lvl_tick >= ms_samples ? (
  lvl_tick = 0;
  lvl_ring[lvl_pos] = 20 * log10(env_fast + 0.0000000001);
  past = lvl_ring[(lvl_pos - MUTE_MS + 128) % 128];
  voiced && since_attack > MUTE_IGNORE_MS * 0.001 * srate &&
    past - lvl_ring[lvl_pos] > MUTE_DROP_DB ? (voiced = 0; need_seed = 1; confirm_n = 0; muted = 1;);
  lvl_pos = (lvl_pos + 1) % 128;
);
!gate_open ? voiced = 0;

// Sine at the tracked pitch, with the guitar's loudness.
amp += (a > amp ? amp_att_c : amp_rel_c) * (a - amp);
pitch > 0 ? (
  osc_phase += pitch / srate;
  osc_phase >= 1 ? osc_phase -= 1;
);
voice_gain += voice_c * (voiced - voice_gain);    // 3 ms fade in and out
voice = sin(2 * $pi * osc_phase) * amp * gate_open * voice_gain;

y = (x + wet * (voice - x)) * outg;
spl0 = spl1 = y;
spl2 = voiced ? pitch / 2000 : 0;
spl3 = tracker ? pll.locked : trk.aper;
