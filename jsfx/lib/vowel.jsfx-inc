// gitSynth shared library: vowel (formant) filter.
// Needs cookdsp (memalloc) and lib/svf.jsfx-inc, imported before this file.
//
// Object, in cookDSP's style:
//   gs_vowel_init()
//   gs_vowel_do(x t v_start v_end q mix)   returns the output
//     t 0-1: position between the start vowel and the end vowel;
//     vowels: 0 A (father), 1 E (bed), 2 I (beet), 3 O (bought), 4 U (boot);
//     q: sharpness of the formant bands (lower is wider and smoother);
//     mix 0-1.
//
// Three band-pass filters in parallel sit at the first three formants of a
// vowel, the resonances that make a voice sound like "ah" or "oo". Moving
// them from one vowel to another gives "wah-ow" and talk-box-like sounds.
// Formants are typical adult male values (Peterson and Barney, 1952);
// frequencies glide on a log scale.

@init

// Level: narrow bands make each note's level depend on whether its harmonics
// land on a formant (measured 12-14 dB note to note on high E at Q 9-16).
// The level match then chased each note, which was heard as the level moving
// after the pick and jumping in fast playing. At Q 2.5 the spread is about
// 4-5 dB, so the level match is now slow (1.5 s, up to +24 dB): it sets the
// overall level without chasing individual notes.
GS_VOWEL_MAX_GAIN = 16;
GS_VOWEL_AGC_S = 1.5;

function gs_vowel_init()
  local(f)
(
  this.f = memalloc(15);     // 5 vowels x 3 formants, Hz
  f = this.f;
  f[0] = 730;  f[1] = 1090; f[2] = 2440;    // A
  f[3] = 530;  f[4] = 1840; f[5] = 2480;    // E
  f[6] = 270;  f[7] = 2290; f[8] = 3010;    // I
  f[9] = 570;  f[10] = 840; f[11] = 2410;   // O
  f[12] = 300; f[13] = 870; f[14] = 2240;   // U
  this.gain = memalloc(3); this.gain[0] = 1; this.gain[1] = 0.5; this.gain[2] = 0.25;
  this.b0.gs_svf_init(); this.b1.gs_svf_init(); this.b2.gs_svf_init();
  this.mix = 0;
  this.pin = this.pout = 0;
  this.agc = 1;
  this.agc_c = 1 - exp(-1 / (GS_VOWEL_AGC_S * srate));
  this.smooth = 1 - exp(-1 / (0.01 * srate));
);

// Centre frequency of formant i, glided on a log scale from the start vowel
// to the end vowel.
function gs_vowel_fc(f v_start v_end i t)
(
  min(f[3 * v_start + i] * (f[3 * v_end + i] / f[3 * v_start + i]) ^ t, 0.45 * srate);
);

function gs_vowel_do(x t v_start v_end q mix)
  local(f gain k out target)
(
  this.mix += this.smooth * (mix - this.mix);
  this.mix > 0.0001 ? (
    f = this.f; gain = this.gain;
    k = 1 / max(0.5, q);
    out = 0;
    // Three band-passes (unity gain at their peaks), in parallel.
    this.b0.gs_svf_set(gs_vowel_fc(f, v_start, v_end, 0, t), k);
    this.b0.gs_svf_tick(x);
    out += gain[0] * k * this.b0.bp;
    this.b1.gs_svf_set(gs_vowel_fc(f, v_start, v_end, 1, t), k);
    this.b1.gs_svf_tick(x);
    out += gain[1] * k * this.b1.bp;
    this.b2.gs_svf_set(gs_vowel_fc(f, v_start, v_end, 2, t), k);
    this.b2.gs_svf_tick(x);
    out += gain[2] * k * this.b2.bp;
    // Level match, held still in near-silence so noise is not boosted.
    this.pin += this.agc_c * (x * x - this.pin);
    this.pout += this.agc_c * (out * out - this.pout);
    this.pin > 0.0000001 ? (
      target = min(GS_VOWEL_MAX_GAIN, sqrt(this.pin / (this.pout + 0.0000000001)));
      this.agc += this.agc_c * (target - this.agc);
    );
    x + this.mix * (this.agc * out - x);
  ) : x;
);
