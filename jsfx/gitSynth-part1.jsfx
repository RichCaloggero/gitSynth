desc:gitSynth Part 1 - processed guitar (step 8: vowel filter)
// Mono guitar in on channel 1; the result goes to channels 1 and 2.
// Stages: input high-pass -> envelope reshaping (swell, sustain, gate)
// -> waveshaper -> envelope-swept resonant state-variable filter
// -> body resonance -> vowel filter -> frequency-shifter ensemble (can be stereo)
// -> vibrato -> dry/wet -> output level.
// The filter sweep follows picking strength before reshaping.

slider1:cutoff_hz=300<40,8000,1:log>Base cutoff (Hz)
slider2:depth_oct=3<0,6,0.1>Sweep depth (octaves)
slider3:direction=0<0,1,1{Up,Down}>Sweep direction
slider4:sens_db=0<-24,24,0.5>Sensitivity (dB)
slider5:att_ms=3<0.5,50,0.1:log>Sweep attack (ms)
slider6:rel_ms=250<10,2000,1:log>Sweep release (ms)
slider7:reso=50<0,100,1>Resonance (%)
slider8:mode=0<0,2,1{Low-pass,Band-pass,High-pass}>Filter type
slider10:mix=100<0,100,1>Dry/wet (%)
slider11:out_db=0<-24,12,0.1>Output level (dB)
slider13:swell_ms=1<1,2000,1:log>Note attack time (ms)
slider14:sustain=0<0,100,1>Sustain (%)
slider15:sus_margin_db=3<0,12,0.5>Sustain level (dB below note start)
slider16:env_mode=0<0,1,1{Follow guitar,Hold}>Envelope mode
slider17:gate_db=-45<-90,-20,0.5>Gate threshold (dB)
slider18:onset_db=6<3,20,0.5>Attack threshold (dB)
slider20:drive_db=0<0,36,0.5>Drive (dB)
slider21:shape=0<0,2,1{Soft clip,Asymmetric,Wave fold}>Shaper type
slider22:shaper_mix=100<0,100,1>Shaper mix (%)
slider24:body_type=0<0,2,1{Violin,Viola,Cello}>Body type
slider25:body_amt=0<0,100,1>Body amount (%)
slider27:ens_hz=1<0.05,10,0.05:log>Ensemble shift (Hz)
slider28:ens_copies=1<0,1,1{One (up),Two (up and down)}>Ensemble copies
slider29:ens_mix=0<0,100,1>Ensemble mix (%)
slider30:ens_spread=0<0,100,1>Ensemble stereo spread (%)
slider31:ens_lfo_rate=0.3<0.05,10,0.01:log>Ensemble LFO rate (Hz)
slider32:ens_lfo_depth=0<0,100,1>Ensemble LFO depth (%)
slider33:ens_lfo_shape=3<0,3,1{Sine,Triangle,Random step,Random smooth}>Ensemble LFO shape
slider35:vib_cents=0<0,100,1>Vibrato depth (cents)
slider36:vib_rate=5.5<0.5,12,0.1:log>Vibrato rate (Hz)
slider37:vib_shape=0<0,3,1{Sine,Triangle,Random step,Random smooth}>Vibrato shape
slider38:vib_onset_ms=300<0,2000,10>Vibrato onset delay (ms)
slider39:vib_fade_ms=500<0,2000,10>Vibrato fade-in (ms)
slider41:vow_start=3<0,4,1{A (father),E (bed),I (beet),O (bought),U (boot)}>Vowel start
slider42:vow_end=0<0,4,1{A (father),E (bed),I (beet),O (bought),U (boot)}>Vowel end
slider43:vow_sweep=100<0,100,1>Vowel sweep (%)
slider44:vow_mix=0<0,100,1>Vowel mix (%)
slider45:vow_q=2.5<1,12,0.1:log>Vowel band sharpness (Q, lower is smoother)

import cookdsp/cookdsp.jsfx-inc
import lib/svf.jsfx-inc
import lib/dynamics.jsfx-inc
import lib/shaper.jsfx-inc
import lib/freqshift.jsfx-inc
import lib/vibrato.jsfx-inc
import lib/vowel.jsfx-inc

in_pin:Guitar
out_pin:Left
out_pin:Right

@init
__memory_next = 0;   // cookDSP's memalloc starts again on every re-init
HP_HZ = 70;          // input high-pass; also removes DC
FLOOR_DB = -48;      // envelope level that gives no sweep
RANGE_DB = 48;       // envelope span from no sweep to full sweep
SMOOTH_MS = 10;      // slider smoothing, avoids zipper noise
NOTE_REF_SAMPLES = floor(0.03 * srate);   // how long after an attack its level is measured
MAX_GAIN_DB = 30;    // most that sustain will boost a quiet note
GATE_HYST_DB = 6;    // gate closes this far below its threshold
SHAPER_REF = 0.25;   // typical level (-12 dBFS) kept steady as drive rises

smooth = 1 - exp(-1 / (SMOOTH_MS * 0.001 * srate));
nyq_limit = 0.45 * srate;

// Input high-pass: fixed state-variable filter, Q 0.707.
hpf.gs_svf_init();
hpf.gs_svf_set(HP_HZ, sqrt(2));

// Fixed time constants for the reshaping detectors.
// Envelope followers, gate and attack detector, from lib/dynamics.jsfx-inc.
sweep_env.gs_env_init();                          // filter sweep; times from sliders
fast_env.gs_env_init();
fast_env.gs_env_set(0.001, 0.05);                 // swell and attack detector
level_env.gs_env_init();
level_env.gs_env_set(0.001, 0.2);                 // 1 ms catches the pick (no pop); 200 ms little ripple on low E
ngate.gs_gate_init();                             // threshold from slider; 2 ms in, 150 ms out
att.gs_attack_init();
att.gs_attack_set(0.03);                          // 30 ms slow side of the attack detector
vib_fall_c = 1 - exp(-1 / (0.1 * srate));        // 100 ms, vibrato fade-out on a new note

flt.gs_svf_init();
env_slow = 0;
note_ref_db = -200; note_ref_n = 0;

// Waveshaper, from lib/shaper.jsfx-inc (includes its 20 Hz DC blocker).
sh.gs_shaper_init();

// Start smoothed values at their targets so nothing sweeps on load.
first = 1;

// Body resonance: bell filters at the main resonances of a violin body.
// Viola and cello use the same shape, scaled down in frequency.
// These are approximate starting values, to be tuned by ear.
bb0.gs_svf_init(); bb1.gs_svf_init(); bb2.gs_svf_init(); bb3.gs_svf_init(); bb4.gs_svf_init();

// Frequency-shifter ensemble, from lib/freqshift.jsfx-inc.
ens.gs_ensemble_init();

// Vibrato, from lib/vibrato.jsfx-inc, with its delayed onset.
vib.gs_vibrato_init();
vib_timer = 0;
vib_gain = 0;

// Vowel filter, from lib/vowel.jsfx-inc.
vow.gs_vowel_init();


@slider
sweep_env.gs_env_set(att_ms * 0.001, rel_ms * 0.001);
ngate.gs_gate_set(gate_db, GATE_HYST_DB, 0.002, 0.15);
swell_c = 1 - exp(-1 / (swell_ms * 0.001 * srate));
q = 0.5 * pow(40, reso / 100);          // Q from 0.5 to 20
t_k = 1 / q;
t_comp = min(1, 1 / sqrt(q / 0.707));   // tame the resonant peak
t_cut = log(cutoff_hz) / log(2);        // base cutoff in octaves
t_depth = direction ? -depth_oct : depth_oct;
t_wet = mix / 100;
t_out = 10 ^ (out_db / 20);
onset_ratio = 10 ^ (onset_db / 20);
t_sus = env_mode ? 1 : sustain / 100;   // Hold is full sustain
// Drive of 0 dB bypasses the shaper; otherwise keep a -12 dBFS signal at
// about the same level whatever the drive.
t_drive = 10 ^ (drive_db / 20);
t_scomp = SHAPER_REF / gs_shaper_size(t_drive * SHAPER_REF, shape);
t_smix = drive_db > 0 ? shaper_mix / 100 : 0;

// Body bells (trapezoidal state-variable bell filters).
body_scale = body_type == 0 ? 1 : body_type == 1 ? 0.83 : 0.42;
// Five bells at the main violin body resonances (gain in dB at 100%).
bb0.gs_svf_bell_coef(min(nyq_limit, 275 * body_scale), 4, 6 * body_amt / 100);    // air resonance
bb1.gs_svf_bell_coef(min(nyq_limit, 460 * body_scale), 5, 5 * body_amt / 100);    // lower main body resonance
bb2.gs_svf_bell_coef(min(nyq_limit, 550 * body_scale), 5, 6 * body_amt / 100);    // upper main body resonance
bb3.gs_svf_bell_coef(min(nyq_limit, 1500 * body_scale), 1.5, -4 * body_amt / 100); // dip below the bridge hill
bb4.gs_svf_bell_coef(min(nyq_limit, 2500 * body_scale), 1.2, 7 * body_amt / 100); // bridge hill, gives the bite
body_makeup = 10 ^ (-1.5 * body_amt / 100 / 20);  // offsets the boosts
first ? (
  k = t_k; comp = t_comp; cut = t_cut; depth = t_depth;
  wet = t_wet; outg = t_out; sus = t_sus;
  drive = t_drive; smix = t_smix; scomp = t_scomp;
  first = 0;
);

@sample
x = spl0;

// Input high-pass.
hpf.gs_svf_tick(x);
x = hpf.hp;

// Envelope follower for the sweep: peak detector with separate attack and release.
a = abs(x);
env = sweep_env.gs_env_do(a);

// Smooth the slider values.
k += smooth * (t_k - k);
comp += smooth * (t_comp - comp);
cut += smooth * (t_cut - cut);
depth += smooth * (t_depth - depth);
wet += smooth * (t_wet - wet);
outg += smooth * (t_out - outg);
sus += smooth * (t_sus - sus);
drive += smooth * (t_drive - drive);
smix += smooth * (t_smix - smix);
scomp += smooth * (t_scomp - scomp);

// Swell: a slow copy of a fast envelope rises at the note attack time but
// falls with it at once, so their ratio fades each new attack in.
env_fast = fast_env.gs_env_do(a);
env_slow += (env_fast > env_slow ? swell_c : 1) * (env_fast - env_slow);
swell_gain = env_slow / (env_fast + 0.000000001);

// Sustain and gate, from the peak level before the swell.
level = level_env.gs_env_do(a);
level_db = 20 * log10(level + 0.0000000001);
ngate.gs_gate_do(level_db);
gate_open = ngate.open;
gate_gain = ngate.gain;

// Attack detector for the vibrato onset: a new note is a rise of the
// fast envelope above a 30 ms copy of it by the attack threshold.
att.gs_attack_do(env_fast, onset_ratio, gate_open);
attack = att.on;

// Sustain lifts a decaying note back towards its own starting level (the
// loudest point in the first 30 ms after its attack, less the sustain level). It
// never turns a note down, so hard notes stay hard and soft notes soft.
attack ? (note_ref_db = level_db; note_ref_n = NOTE_REF_SAMPLES;);
note_ref_n > 0 ? (note_ref_n -= 1; note_ref_db = max(note_ref_db, level_db););
(level_db > note_ref_db || !gate_open) ? note_ref_db = level_db;   // nothing to lift between notes
sus_db = min(MAX_GAIN_DB, max(0, sus * (note_ref_db - sus_margin_db - level_db)));

// Vibrato onset: starts after the onset delay and fades in; a new note fades
// it out over 100 ms and starts again.
(attack || !gate_open) ? (
  vib_timer = 0;
) : (
  vib_timer += 1 / srate;
);
vib_t = vib_timer * 1000 - vib_onset_ms;
vib_target = vib_t <= 0 ? 0 : vib_fade_ms <= 0 ? 1 : min(1, vib_t / vib_fade_ms);
vib_gain = vib_target >= vib_gain ? vib_target : vib_gain + vib_fall_c * (vib_target - vib_gain);

shaped = x * swell_gain * 10 ^ (sus_db / 20) * gate_gain;

// Waveshaper, then a DC blocker for the asymmetric curve's offset.
smix > 0.0001 ? (
  shaped += smix * (sh.gs_shaper_do(shaped, drive, scomp, shape) - shaped);
);

// Envelope-swept state-variable filter (trapezoidal, stable when modulated).
env_db = 20 * log10(env + 0.0000001) + sens_db;
amt = max(0, min(1, (env_db - FLOOR_DB) / RANGE_DB));
fc = 2 ^ (cut + depth * amt);
fc = max(20, min(nyq_limit, fc));

flt.gs_svf_set(fc, k);
flt.gs_svf_tick(shaped);
// Band-pass is unity gain at its peak; low- and high-pass get the compensation.
y = mode == 1 ? flt.bp * k : (mode == 0 ? flt.lp : flt.hp) * comp;

// Body resonance.
body_amt > 0 ? (
  bb0.gs_svf_tick(y); y = bb0.bell;
  bb1.gs_svf_tick(y); y = bb1.bell;
  bb2.gs_svf_tick(y); y = bb2.bell;
  bb3.gs_svf_tick(y); y = bb3.bell;
  bb4.gs_svf_tick(y); y = bb4.bell;
  y *= body_makeup;
);

// Vowel filter: picking strength (the same sweep amount as the main filter)
// moves it from the start vowel towards the end vowel.
y = vow.gs_vowel_do(y, amt * vow_sweep / 100, vow_start, vow_end, vow_q, vow_mix / 100);

// Frequency-shifter ensemble: copies of the sound shifted up (and down) by a
// few Hz, mixed back with it. Two copies can be spread across the stereo field.
ens.gs_ensemble_do(y, ens_hz, ens_copies, ens_mix / 100, ens_spread / 100,
                   ens_lfo_rate, ens_lfo_depth / 100, ens_lfo_shape);

// Vibrato on both channels together; depth 0 bypasses it.
yl = ens.l; yr = ens.r;
vib_cents > 0 ? (
  vib.gs_vibrato_do(yl, yr, vib_cents, vib_rate, vib_shape, vib_gain);
  yl = vib.l; yr = vib.r;
);

spl0 = (x + wet * (yl - x)) * outg;
spl1 = (x + wet * (yr - x)) * outg;
